# =================================================
# 
# RaggieSoft Master Git Ignore Rules
# 
# =================================================

# --- Audio Source Files ---
*.wav
*.aiff
*.flac
*.alac
*.dsd
*.dff
*.dsf

# --- Generated Audio Files ---
*.mp3
*.ogg
*.aac
*.m4a
*.wma

# --- High-Resolution Design & Art Files ---
*.psd
*.psb
*.ai
*.eps
*.tiff
*.tif
*.raw
*.cr2
*.dng

# --- Video & Motion Graphics ---
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.prproj
*.aep

# --- Archives & Compressed Files ---
*.7z
*.zip
*.tar.gz
*.rar
*.gz

# --- Disc Image & Binary Data ---
*.iso
*.bin
*.cue
*.img
*.dmg

# --- OS Generated Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / Editor Configs ---
.vscode/
.idea/
*.swp

# --- Narrative & Reference Assets ---
_workspace/books/*/images/source/
_workspace/books/*/images/people/real-person/

# Ignore all Upscayl output directories and contents
*[Uu]pscayl*/
*upscayl*.png

# --- WORKSPACE SECURITY ---
_workspace/build-tools/rclone/rclone.conf
_workspace/build-tools/ssh_keys.txt
!_workspace/build-tools/rclone/rclone.conf.example

# --- WORKSPACE & TOOLS ---
_workspace/build-tools/
!_workspace/build-tools/rclone/rclone.conf.example

# --- Google Analytics 4 API Credentials ---
ga4-credentials.json
*_credentials*.json
*service-account*.json

# --- Python Virtual Environment ---
.venv/
__pycache__/

# --- Node / Next.js / Web ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
# /out/  <- Allowed so Jenna can push the static build for Sarah to pull
/build
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
.vercel
*.tsbuildinfo
next-env.d.ts

# --- Project Specific Overrides ---
/lore/**/_old/
orion.php
